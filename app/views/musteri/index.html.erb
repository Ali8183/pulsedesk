<div style="max-width: 960px; margin: 0 auto 3rem;">

  <!-- Müşteri Başlık & Profil Alanı -->
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle);">
    <div>
      <div style="font-size: 0.8rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">
        Müşteri Destek Portalı
      </div>
      <h1 style="font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary);">
        Taleplerim & Destek Merkezi
      </h1>
      <p style="color: var(--text-muted); font-size: 0.88rem;">
        Aktif Müşteri: <strong><%= current_customer_name %></strong> (<%= current_customer_email %>)
      </p>
    </div>

    <div>
      <button type="button" class="btn btn-primary btn-sm" id="btn-toggle-new-ticket" onclick="toggleNewTicketForm()">
        + Yeni Destek Talebi Aç
      </button>
    </div>
  </div>

  <!-- 1. Müşterinin Kendi Talepleri Tablosu -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <div class="card-title">
        Destek Taleplerim (<%= @tickets.count %>)
      </div>
      <span style="font-size: 0.78rem; color: var(--text-muted);">
        Yalnızca sizin e-posta adresinize (<%= current_customer_email %>) ait talepler listelenir.
      </span>
    </div>

    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 80px;">Bilet No</th>
            <th style="width: 100px;">Öncelik</th>
            <th>Konu Başlığı</th>
            <th style="width: 120px;">Durum</th>
            <th style="width: 150px;">Oluşturulma</th>
            <th style="width: 100px; text-align: right;">İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% if @tickets.any? %>
            <% @tickets.each do |ticket| %>
              <tr>
                <td style="color: var(--text-muted); font-weight: 600;">
                  #<%= ticket.id %>
                </td>

                <td>
                  <span class="badge badge-<%= ticket.priority %>">
                    <%= ticket.human_priority_name %>
                  </span>
                </td>

                <td>
                  <a href="<%= musteri_ticket_path(ticket) %>" class="ticket-link">
                    <%= ticket.title %>
                  </a>
                  <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 2px;">
                    <span>İlgilenen Temsilci: <strong><%= ticket.assigned_agent.presence || "Sıraya alındı (Atanıyor)" %></strong></span>
                    <% unless ticket.status_solved? || ticket.status_closed? %>
                      <span style="color: var(--border-strong);">•</span>
                      <span class="live-sla-timer" data-due="<%= ticket.sla_due_at.iso8601 %>" style="color: #2563eb; font-weight: 600;">
                        ⏱️ <span class="timer-text"><%= ticket.sla_remaining_seconds / 3600 %>s <%= sprintf('%02d', (ticket.sla_remaining_seconds % 3600) / 60) %>dk <%= sprintf('%02d', ticket.sla_remaining_seconds % 60) %>sn kaldı</span>
                      </span>
                    <% end %>
                  </div>
                </td>

                <td>
                  <% status_class = case ticket.status
                     when "status_new" then "new"
                     when "status_open" then "open"
                     when "status_pending" then "pending"
                     when "status_solved" then "solved"
                     when "status_closed" then "closed"
                     end %>
                  <span class="badge badge-<%= status_class %>">
                    <%= ticket.human_status_name %>
                  </span>
                </td>

                <td style="font-size: 0.8rem; color: var(--text-muted);">
                  <%= ticket.created_at.strftime("%d.%m.%Y %H:%M") %>
                </td>

                <td style="text-align: right;">
                  <a href="<%= musteri_ticket_path(ticket) %>" class="btn btn-secondary btn-sm">
                    Görüntüle →
                  </a>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" style="text-align: center; padding: 3rem 1.5rem; color: var(--text-muted);">
                <div style="font-size: 1.8rem; margin-bottom: 0.5rem;">📋</div>
                <strong style="color: var(--text-primary); font-size: 1rem; display: block; margin-bottom: 0.35rem;">
                  Henüz Kayıtlı Bir Destek Talebiniz Yok
                </strong>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
                  Bir sorun veya sorunuz varsa, destek ekibimize hemen talep iletebilirsiniz.
                </p>
                <button type="button" class="btn btn-primary btn-sm" onclick="toggleNewTicketForm(true)">
                  + İlk Destek Talebini Oluştur
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 2. Yeni Destek Talebi Açma Formu (Varsayılan Olarak Gizli, Butonla Açılır) -->
  <div class="card" id="yeni-talep-card" style="padding: 2rem; display: <%= (@new_ticket&.errors&.any?) ? 'block' : 'none' %>;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
      <div>
        <div style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.25rem;">
          Yeni Destek Talebi Oluştur
        </div>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
          Sorununuzu iletin, şirketimizin destek ekibi sözleşme SLA süresi içinde müdahale etsin.
        </p>
      </div>
      <button type="button" class="btn btn-secondary btn-xs" onclick="toggleNewTicketForm(false)" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;" title="Formu Kapat">
        ✕ Kapat
      </button>
    </div>

    <% if @new_ticket&.errors&.any? %>
      <div class="flash-alert flash-alert-danger" style="margin-bottom: 1.25rem;">
        <div>
          <strong>Lütfen formu kontrol edin:</strong>
          <ul style="margin: 0.35rem 0 0; padding-left: 1.25rem;">
            <% @new_ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_with model: @new_ticket, url: musteri_talep_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :priority, "Talebin Aciliyeti *", class: "form-label" %>
        <%= f.select :priority, [
          ["⚡ Acil - Kritik Arıza (2 Saat Hedef)", "urgent"],
          ["🔴 Yüksek Öncelik (4 Saat Hedef)", "high"],
          ["🔵 Normal Talep (8 Saat Hedef)", "medium"]
        ], { selected: "urgent" }, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :title, "Konu Başlığı *", class: "form-label" %>
        <%= f.text_field :title, id: "musteri-ticket-title", class: "form-control", placeholder: "Örn: Ödeme ekranında 403 hatası alıyoruz", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :description, "Yaşadığınız Sorunun Detayı *", class: "form-label" %>
        <%= f.text_area :description, id: "musteri-ticket-description", rows: 4, class: "form-control", placeholder: "Lütfen sorunu olabildiğince detaylı açıklayın...", required: true %>
      </div>

      <div style="display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
        <button type="button" class="btn btn-secondary" onclick="toggleNewTicketForm(false)">
          Vazgeç
        </button>
        <button type="submit" class="btn btn-primary" id="btn-submit-musteri-ticket">
          Destek Talebini Gönder →
        </button>
      </div>
    <% end %>
  </div>

</div>

<script>
  function toggleNewTicketForm(forceState) {
    const card = document.getElementById('yeni-talep-card');
    const btn = document.getElementById('btn-toggle-new-ticket');
    if (!card) return;

    const isVisible = card.style.display !== 'none';
    const willShow = (typeof forceState === 'boolean') ? forceState : !isVisible;

    if (willShow) {
      card.style.display = 'block';
      if (btn) {
        btn.textContent = '✕ Formu Gizle';
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-secondary');
      }
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      const titleInput = document.getElementById('musteri-ticket-title');
      if (titleInput) {
        setTimeout(() => titleInput.focus(), 250);
      }
    } else {
      card.style.display = 'none';
      if (btn) {
        btn.textContent = '+ Yeni Destek Talebi Aç';
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-primary');
      }
    }
  }

  function checkFormHash() {
    if (window.location.hash === '#yeni-talep' || window.location.hash === '#yeni-talep-card' || <%= @new_ticket&.errors&.any? ? 'true' : 'false' %>) {
      toggleNewTicketForm(true);
    }
  }

  document.addEventListener('DOMContentLoaded', checkFormHash);
  document.addEventListener('turbo:load', checkFormHash);

  (function() {
    let pollInterval = null;
    let timerInterval = null;

    function updateCustomerSLATimers() {
      const now = Date.now();
      document.querySelectorAll('.live-sla-timer').forEach(el => {
        const dueIso = el.getAttribute('data-due');
        if (!dueIso) return;
        const dueTime = new Date(dueIso).getTime();
        const diffSec = Math.floor((dueTime - now) / 1000);

        if (diffSec <= 0) {
          el.innerHTML = '<span style="color: var(--danger); font-weight: 700;">⚠️ SLA Süresi Aşıldı</span>';
        } else {
          const hours = Math.floor(diffSec / 3600);
          const mins = Math.floor((diffSec % 3600) / 60);
          const secs = diffSec % 60;
          const textEl = el.querySelector('.timer-text');
          if (textEl) {
            const hStr = hours > 0 ? `${hours}s ` : '';
            const mStr = `${mins < 10 ? '0' : ''}${mins}dk `;
            const sStr = `${secs < 10 ? '0' : ''}${secs}sn kaldı`;
            textEl.textContent = `${hStr}${mStr}${sStr}`;
          }
        }
      });
    }

    async function pollCustomerIndex() {
      // Eğer kullanıcı form yazıyorsa kesme
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT')) {
        return;
      }

      try {
        const response = await fetch(window.location.href, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) return;

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newTbody = doc.querySelector('tbody');
        const currentTbody = document.querySelector('tbody');

        if (newTbody && currentTbody && newTbody.innerHTML !== currentTbody.innerHTML) {
          currentTbody.innerHTML = newTbody.innerHTML;
          updateCustomerSLATimers();
        }
      } catch (e) {
        // Sessiz hata yakalama
      }
    }

    timerInterval = setInterval(updateCustomerSLATimers, 1000);
    updateCustomerSLATimers();

    pollInterval = setInterval(pollCustomerIndex, 3000);

    document.addEventListener('turbo:before-cache', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    }, { once: true });

    window.addEventListener('beforeunload', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    });
  })();
</script>

