<div style="max-width: 460px; margin: 2rem auto 3rem;">
  
  <div style="text-align: center; margin-bottom: 1.75rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </div>
    <h1 style="font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.35rem;">
      Müşteri Destek Portalı
    </h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.45;">
      Destek taleplerinizi iletmek veya mevcut taleplerinizin durumunu canlı takip etmek için giriş yapın veya kayıt olun.
    </p>
  </div>

  <div class="card" style="padding: 1.75rem;">
    <!-- Sekme Geçişi: Giriş Yap vs Kayıt Ol -->
    <div class="tab-container">
      <button type="button" id="tab-btn-login" class="tab-btn active" onclick="switchCustomerTab('login')">
        🔑 Giriş Yap
      </button>
      <button type="button" id="tab-btn-register" class="tab-btn" onclick="switchCustomerTab('register')">
        ✨ Yeni Kayıt Ol
      </button>
    </div>

    <!-- 1. SEKME: GİRİŞ YAP (MEVCUT MÜŞTERİ) -->
    <div id="section-login" style="display: block;">
      <%= form_with url: musteri_giris_path, method: :post, local: true do |f| %>
        <div class="form-group">
          <%= f.label :email, "Kayıtlı E-Posta Adresiniz *", class: "form-label" %>
          <%= f.email_field :email, id: "customer-login-email", value: "murat.demir@global-logistics.com", class: "form-control", placeholder: "ornek@sirketiniz.com", required: true %>
          <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.3rem; display: block;">
            Daha önce talep açarken kullandığınız e-posta adresiniz.
          </span>
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.7rem; font-weight: 600;">
            Giriş Yap ve Taleplerimi Gör →
          </button>
        </div>
      <% end %>

      <!-- Hızlı Sunum Seçenekleri -->
      <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-subtle);">
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.65rem; text-align: center;">
          ⚡ Hızlı Sunum İçin Hazır Müşteri Profilleri
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.45rem;">
          <%= button_to musteri_giris_path(email: "murat.demir@global-logistics.com", name: "Murat Demir"), method: :post, class: "btn btn-secondary btn-sm", style: "width: 100%; justify-content: flex-start; padding: 0.5rem 0.75rem;" do %>
            <span>🏢</span>
            <div style="text-align: left; margin-left: 0.4rem;">
              <div style="font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">Murat Demir</div>
              <div style="font-size: 0.72rem; color: var(--text-muted);">murat.demir@global-logistics.com</div>
            </div>
          <% end %>

          <%= button_to musteri_giris_path(email: "deniz@cloud-scale.net", name: "Deniz Arslan"), method: :post, class: "btn btn-secondary btn-sm", style: "width: 100%; justify-content: flex-start; padding: 0.5rem 0.75rem;" do %>
            <span>🏢</span>
            <div style="text-align: left; margin-left: 0.4rem;">
              <div style="font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">Deniz Arslan</div>
              <div style="font-size: 0.72rem; color: var(--text-muted);">deniz@cloud-scale.net</div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 2. SEKME: YENİ KAYIT OL -->
    <div id="section-register" style="display: none;">
      <%= form_with url: musteri_kayit_path, method: :post, local: true do |f| %>
        <div class="form-group">
          <%= f.label :name, "Adınız Soyadınız *", class: "form-label" %>
          <%= f.text_field :name, id: "customer-register-name", class: "form-control", placeholder: "Örn: Ali Yılmaz", required: true %>
        </div>

        <div class="form-group" style="margin-top: 1rem;">
          <%= f.label :email, "E-Posta Adresiniz *", class: "form-label" %>
          <%= f.email_field :email, id: "customer-register-email", class: "form-control", placeholder: "ornek@sirketiniz.com", required: true %>
          <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.3rem; display: block;">
            Temsilcilerimizin yanıtları ve durum güncellemeleri bu adrese iletilecektir.
          </span>
        </div>

        <div style="margin-top: 1.5rem;">
          <button type="submit" class="btn btn-success" style="width: 100%; justify-content: center; padding: 0.7rem; font-weight: 600;">
            Hesabımı Oluştur ve Panele Gir →
          </button>
        </div>
      <% end %>

      <div class="register-info-box">
        🛡️ Kayıt olduktan sonra hemen destek talebinizi açabilir, temsilcilerimizin anlık yanıtlarını ve çözüm sürecini panelinizden takip edebilirsiniz.
      </div>
    </div>

  </div>

  <div style="text-align: center; margin-top: 1.5rem;">
    <span style="color: var(--text-muted); font-size: 0.82rem;">
      PulseDesk Müşteri İletişim Portalı
    </span>
  </div>

</div>

<script>
  function switchCustomerTab(tab) {
    var loginSec = document.getElementById('section-login');
    var regSec = document.getElementById('section-register');
    var loginBtn = document.getElementById('tab-btn-login');
    var regBtn = document.getElementById('tab-btn-register');

    if (!loginSec || !regSec || !loginBtn || !regBtn) return;

    if (tab === 'register') {
      loginSec.style.display = 'none';
      regSec.style.display = 'block';

      loginBtn.classList.remove('active');
      regBtn.classList.add('active');

      var nameInput = document.getElementById('customer-register-name');
      if (nameInput) nameInput.focus();
    } else {
      regSec.style.display = 'none';
      loginSec.style.display = 'block';

      regBtn.classList.remove('active');
      loginBtn.classList.add('active');

      var emailInput = document.getElementById('customer-login-email');
      if (emailInput) emailInput.focus();
    }
  }

  function initCustomerTab() {
    <% if @tab == "register" %>
      switchCustomerTab('register');
    <% else %>
      if (window.location.hash === '#register' || window.location.search.indexOf('tab=register') !== -1) {
        switchCustomerTab('register');
      }
    <% end %>
  }

  document.addEventListener('DOMContentLoaded', initCustomerTab);
  document.addEventListener('turbo:load', initCustomerTab);
</script>
