<div style="max-width: 440px; margin: 2rem auto 3rem;">
  
  <div style="text-align: center; margin-bottom: 2rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </div>
    <h1 style="font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.35rem;">
      Müşteri Destek Girişi
    </h1>
    <p style="color: var(--text-muted); font-size: 0.88rem;">
      Destek taleplerinizi takip etmek ve yeni talep açmak için e-posta adresinizle giriş yapın.
    </p>
  </div>

  <div class="card" style="padding: 2rem;">
    <%= form_with url: musteri_giris_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, "E-Posta Adresiniz *", class: "form-label" %>
        <%= f.email_field :email, id: "customer-login-email", value: "murat.demir@global-logistics.com", class: "form-control", placeholder: "ornek@sirketiniz.com", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :name, "Adınız Soyadınız (İsteğe Bağlı)", class: "form-label" %>
        <%= f.text_field :name, id: "customer-login-name", value: "Murat Demir", class: "form-control", placeholder: "Örn: Murat Demir" %>
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.7rem;">
          Müşteri Portalıma Gir →
        </button>
      </div>
    <% end %>

    <!-- Hızlı Demo Girişi (5 Dakikalık Sunumda Zaman Kazandırır) -->
    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-subtle);">
      <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.75rem; text-align: center;">
        ⚡ Sunum İçin Hazır Müşteri Seçimi
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <%= button_to musteri_giris_path(email: "murat.demir@global-logistics.com", name: "Murat Demir"), method: :post, class: "btn btn-secondary btn-sm", style: "width: 100%; justify-content: flex-start; padding: 0.5rem 0.75rem;" do %>
          <span>🏢</span>
          <div style="text-align: left; margin-left: 0.4rem;">
            <div style="font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">Murat Demir (Global Logistics)</div>
            <div style="font-size: 0.72rem; color: var(--text-muted);">murat.demir@global-logistics.com (Kayıtlı Talepleri Var)</div>
          </div>
        <% end %>

        <%= button_to musteri_giris_path(email: "deniz@cloud-scale.net", name: "Deniz Arslan"), method: :post, class: "btn btn-secondary btn-sm", style: "width: 100%; justify-content: flex-start; padding: 0.5rem 0.75rem;" do %>
          <span>🏢</span>
          <div style="text-align: left; margin-left: 0.4rem;">
            <div style="font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">Deniz Arslan (Cloud Scale)</div>
            <div style="font-size: 0.72rem; color: var(--text-muted);">deniz@cloud-scale.net (Acil Talebi Var)</div>
          </div>
        <% end %>

        <%= button_to musteri_giris_path(email: "ali.ogrenci@universite.edu.tr", name: "Ali Öğrenci"), method: :post, class: "btn btn-secondary btn-sm", style: "width: 100%; justify-content: flex-start; padding: 0.5rem 0.75rem;" do %>
          <span>🆕</span>
          <div style="text-align: left; margin-left: 0.4rem;">
            <div style="font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">Yeni Müşteri (Sıfırdan Talep Aç)</div>
            <div style="font-size: 0.72rem; color: var(--text-muted);">ali.ogrenci@universite.edu.tr</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 1.5rem;">
    <a href="/" style="color: var(--text-muted); font-size: 0.84rem; text-decoration: none;">
      ← Ana Sayfaya Dön
    </a>
    <span style="color: var(--border-strong); margin: 0 0.5rem;">•</span>
    <a href="/temsilci" style="color: #6d28d9; font-size: 0.84rem; text-decoration: none; font-weight: 600;">
      Yetkili Temsilci Girişi (/temsilci) 🔒
    </a>
  </div>

</div>
