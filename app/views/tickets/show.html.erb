<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <a href="<%= temsilci_path %>" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 0.5rem; font-weight: 500;">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Talepler Listesine Dön
    </a>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <h1 style="font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary);">
        <%= @ticket.title %>
      </h1>
      <span style="color: var(--text-muted); font-size: 1.05rem; font-weight: 600;">#<%= @ticket.id %></span>
    </div>
  </div>

  <div style="display: flex; align-items: center; gap: 0.5rem;">
    <span class="badge badge-<%= @ticket.priority %>" style="font-size: 0.82rem; padding: 4px 12px;">
      Öncelik: <%= @ticket.human_priority_name %>
    </span>

    <% status_class = case @ticket.status
       when "status_new" then "new"
       when "status_open" then "open"
       when "status_pending" then "pending"
       when "status_solved" then "solved"
       when "status_closed" then "closed"
       end %>
    <span class="badge badge-<%= status_class %>" style="font-size: 0.82rem; padding: 4px 12px;">
      Durum: <%= @ticket.human_status_name %>
    </span>
  </div>
</div>

<div class="detail-layout">
  <!-- Sol Kolon: Bilet İçeriği, Durum Geçişleri ve Mesajlaşma -->
  <div class="detail-main">

    <!-- Bilet Açıklaması -->
    <div class="card" style="padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
        <div style="display: flex; align-items: center; gap: 0.65rem;">
          <div class="author-avatar avatar-customer">
            <%= @ticket.customer_name[0] %>
          </div>
          <div>
            <strong style="color: var(--text-primary); font-size: 0.92rem;"><%= @ticket.customer_name %></strong>
            <span style="color: var(--text-muted); font-size: 0.8rem; margin-left: 0.35rem;"><%= @ticket.customer_email %></span>
          </div>
        </div>
        <span style="color: var(--text-muted); font-size: 0.78rem;">
          <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %>
        </span>
      </div>

      <div style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap;">
        <%= @ticket.description %>
      </div>
    </div>

    <!-- Bilet Durum Akışı & Aksiyon Çubuğu -->
    <div class="card" style="padding: 1.15rem 1.35rem; background: #f8fafc;">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
        <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">
          Bilet Yaşam Döngüsü
        </span>

        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <!-- Temsilci Atama / Değiştirme -->
          <% unless @ticket.status_closed? %>
            <%= form_with url: assign_ticket_path(@ticket), method: :patch, local: true, style: "display: inline-flex; gap: 0.4rem; align-items: center;" do |f| %>
              <%= select_tag :agent_name, options_for_select([["Ahmet Kaya", "Ahmet Kaya"], ["Selin Yılmaz", "Selin Yılmaz"], ["Elif Tekin", "Elif Tekin"]], @ticket.assigned_agent), class: "form-control", style: "padding: 0.35rem 0.6rem; font-size: 0.82rem; width: auto;" %>
              <button type="submit" class="btn btn-primary btn-sm">
                <%= @ticket.assigned_agent.present? ? "Temsilciyi Değiştir" : "Temsilci Ata & Açık Yap" %>
              </button>
            <% end %>
          <% end %>

          <!-- Yanıt Bekleniyor Yap -->
          <% if @ticket.can_transition_to?(:status_pending) %>
            <%= button_to transition_ticket_path(@ticket, target_status: :status_pending), method: :patch, class: "btn btn-secondary btn-sm" do %>
              Müşteriden Yanıt Bekleniyor
            <% end %>
          <% end %>

          <!-- Açık Yap (Geri Al) -->
          <% if @ticket.can_transition_to?(:status_open) && !@ticket.status_new? %>
            <%= button_to transition_ticket_path(@ticket, target_status: :status_open), method: :patch, class: "btn btn-secondary btn-sm" do %>
              Açık (Open) Durumuna Al
            <% end %>
          <% end %>

          <!-- Çözüldü Olarak İşaretle -->
          <% if @ticket.can_transition_to?(:status_solved) %>
            <%= button_to transition_ticket_path(@ticket, target_status: :status_solved), method: :patch, class: "btn btn-success btn-sm" do %>
              ✓ Çözüldü Olarak İşaretle
            <% end %>
          <% end %>

          <!-- Kapat (Arşiv) -->
          <% if @ticket.can_transition_to?(:status_closed) %>
            <%= button_to transition_ticket_path(@ticket, target_status: :status_closed), method: :patch, class: "btn btn-secondary btn-sm", data: { confirm: "Bilet tamamen kapatılacak ve üzerinde değişiklik yapılamayacak. Onaylıyor musunuz?" } do %>
              Talebi Kapat
            <% end %>
          <% end %>

          <% if @ticket.status_closed? %>
            <span style="font-size: 0.82rem; color: var(--text-muted); font-style: italic;">
              Bu talep kapatılmıştır (Closed); yaşam döngüsü tamamlandı.
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Mesajlaşma Akışı (Comments Thread) -->
    <div>
      <div style="font-size: 1rem; font-weight: 700; margin-bottom: 0.85rem; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between;">
        <span>İletişim Geçmişi</span>
        <span style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted);"><%= @comments.count %> mesaj</span>
      </div>

      <div class="thread-container">
        <% if @comments.any? %>
          <% @comments.each do |comment| %>
            <div class="comment-card <%= comment.author_role %> <%= 'gratitude-saved' if comment.is_gratitude? %>">
              <div class="comment-header">
                <div class="author-info">
                  <div class="author-avatar <%= comment.author_role == 'agent' ? 'avatar-agent' : 'avatar-customer' %>">
                    <%= comment.author_name[0] %>
                  </div>
                  <div>
                    <strong style="font-size: 0.88rem; color: var(--text-primary);"><%= comment.author_name %></strong>
                    <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 0.35rem;">
                      <%= comment.author_role == 'agent' ? 'Destek Temsilcisi' : 'Müşteri' %>
                    </span>
                  </div>
                </div>

                <span class="comment-time">
                  <%= comment.created_at.strftime("%d.%m.%Y %H:%M") %>
                </span>
              </div>

              <div class="comment-body"><%= comment.body %></div>

              <!-- Gratitude Guard Rozeti -->
              <% if comment.is_gratitude? %>
                <div class="gratitude-banner">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink: 0; margin-top: 2px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                  <div>
                    <strong>Nezaket Koruması (Gratitude Guard):</strong>
                    Müşteri teşekkür mesajı iletti. Bilet durumu <strong>'Çözüldü'</strong> olarak başarıyla korundu ve kuyruğa tekrar düşmesi engellendi.
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div style="text-align: center; padding: 2rem; background: var(--bg-surface); border: 1px dashed var(--border-subtle); border-radius: var(--radius-md); color: var(--text-muted); font-size: 0.88rem;">
            Henüz bir yanıt eklenmedi. Aşağıdaki formdan ilk yanıtı iletebilirsiniz.
          </div>
        <% end %>
      </div>
    </div>

    <!-- Yanıt Ekleme ve Canlı Simülasyon Kartı -->
    <% unless @ticket.status_closed? %>
      <div class="card" style="padding: 1.5rem;">
        <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary);">
          Yeni Yanıt Gönder
        </h4>

        <%= form_with model: [@ticket, @new_comment], local: true, id: "comment-form" do |f| %>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.85rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-subtle);">
            <div style="font-size: 0.84rem; color: var(--text-muted);">
              Yanıtlayan Temsilci: <strong style="color: var(--text-primary);"><%= current_agent %></strong>
            </div>
            <span style="font-size: 0.75rem; background: #f5f3ff; color: #6d28d9; border: 1px solid #ddd6fe; padding: 2px 8px; border-radius: 9999px; font-weight: 600;">
              Resmi Temsilci Yanıtı
            </span>
          </div>

          <div class="form-group">
            <%= f.text_area :body, rows: 3, class: "form-control", id: "comment-body-textarea", placeholder: "Müşteriye iletilecek çözüm veya bilgilendirme mesajınızı yazın...", required: true %>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <button type="submit" class="btn btn-primary" id="btn-submit-comment">
              Müşteriye Yanıt Gönder →
            </button>

            <!-- Hızlı Yanıt Şablonu -->
            <button type="button" class="btn btn-secondary btn-sm" onclick="quickFillAgentSolved()">
              ⚡ "Sorununuz Çözüldü" Şablonunu Ekle
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>

  <!-- Sağ Kolon: SLA Paneli ve Bilet Bilgileri -->
  <div class="detail-sidebar">

    <!-- ZAMAN KURALI: SLA Paneli -->
    <div class="sla-panel <%= 'breached' if @ticket.sla_breached? %>">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
        <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">
          SLA Çözüm Hedefi
        </span>
        <% if @ticket.sla_breached? %>
          <span class="badge badge-breached">İHLAL EDİLDİ</span>
        <% elsif @ticket.status_solved? || @ticket.status_closed? %>
          <span class="badge badge-solved">SLA DURDURULDU</span>
        <% else %>
          <span class="badge badge-open">GERİ SAYIM AKTİF</span>
        <% end %>
      </div>

      <div style="margin-bottom: 1rem;">
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 2px;">
          Tanımlı SLA Politikası:
        </div>
        <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">
          <%= @ticket.sla_hours %> Saat Çözüm Süresi
        </div>
      </div>

      <div style="margin-bottom: 1rem; padding: 0.85rem; background: var(--bg-surface-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Kalan Süre:</div>
        <% if @ticket.status_solved? || @ticket.status_closed? %>
          <div style="font-size: 1rem; font-weight: 700; color: var(--success);">
            Hedef Süre İçinde Çözüldü
          </div>
        <% elsif @ticket.sla_breached? %>
          <div style="font-size: 1.15rem; font-weight: 800; color: var(--danger);">
            SLA Süresi Aşıldı
          </div>
          <div style="font-size: 0.75rem; color: var(--danger-text); margin-top: 2px;">
            Yönetici bildirim bayrağı aktif.
          </div>
        <% else %>
          <% remaining = @ticket.sla_remaining_seconds %>
          <% hours = remaining / 3600 %>
          <% mins = (remaining % 3600) / 60 %>
          <% secs = remaining % 60 %>
          <div class="live-sla-timer" data-due="<%= @ticket.sla_due_at.iso8601 %>" style="font-size: 1.35rem; font-weight: 800; color: <%= @ticket.sla_urgency_level == :warning ? 'var(--warning-text)' : 'var(--text-primary)' %>;">
            <span class="timer-text"><%= "#{hours}s " if hours > 0 %><%= sprintf('%02d', mins) %>dk <%= sprintf('%02d', secs) %>sn kaldı</span>
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
            Son Tarih: <%= @ticket.sla_due_at.strftime("%d.%m.%Y %H:%M") %>
          </div>
        <% end %>
      </div>

      <!-- Sunum Demosu İçin Zaman Makinesi Butonu -->
      <% unless @ticket.status_solved? || @ticket.status_closed? || @ticket.sla_breached? %>
        <%= button_to simulate_time_travel_ticket_path(@ticket), method: :post, class: "btn btn-danger btn-sm", style: "width: 100%; justify-content: center; font-size: 0.78rem;", data: { confirm: "SLA süresi 15 dakika öncesine çekilip SLA ihlali canlıda simüle edilecek. Devam edilsin mi?" } do %>
          ⚡ Zaman Makinesi: SLA Aşımını Simüle Et
        <% end %>
        <div style="font-size: 0.7rem; color: var(--text-muted); text-align: center; margin-top: 4px;">
          (Sunum sırasında canlıda SLA alarmını göstermek için)
        </div>
      <% end %>
    </div>

    <!-- Müşteri ve Sistem Bilgileri -->
    <div class="card" style="padding: 1.25rem;">
      <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: 0.85rem;">
        Talep Bilgileri
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem;">
        <div>
          <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">Müşteri:</span>
          <strong style="color: var(--text-primary);"><%= @ticket.customer_name %></strong>
        </div>

        <div>
          <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">E-Posta:</span>
          <span style="color: var(--text-secondary);"><%= @ticket.customer_email %></span>
        </div>

        <div>
          <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">Atanan Temsilci:</span>
          <strong style="color: var(--text-primary);"><%= @ticket.assigned_agent.presence || "Atanmadı" %></strong>
        </div>

        <div>
          <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">İlk Yanıt Zamanı:</span>
          <span style="color: var(--text-secondary);"><%= @ticket.first_responded_at ? @ticket.first_responded_at.strftime("%d.%m.%Y %H:%M") : "Henüz yanıtlanmadı" %></span>
        </div>

        <% if @ticket.resolved_at %>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">Çözüm Zamanı:</span>
            <span style="color: var(--success);"><%= @ticket.resolved_at.strftime("%d.%m.%Y %H:%M") %></span>
          </div>
        <% end %>

        <div>
          <span style="color: var(--text-muted); display: block; font-size: 0.75rem;">Nezaket Koruması:</span>
          <span style="color: var(--success); font-weight: 600;"><%= @ticket.gratitude_count %> Teşekkür Korundu</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function quickFillAgentSolved() {
    document.getElementById('comment-body-textarea').value = 'Merhaba <%= j @ticket.customer_name %>, bildirdiğiniz konu teknik ekibimizce incelenmiş ve gerekli düzeltme yapılmıştır. Lütfen kontrol edip bize bildirin.';
  }

  // Sayfa Yenilemesiz Canlı Yorum, Durum ve 1-Saniyelik SLA Sayacı Senkronizasyonu
  (function() {
    let currentCommentCount = document.querySelectorAll('.comment-card').length;
    let pollInterval = null;
    let timerInterval = null;

    function updateLiveSLATimers() {
      const now = Date.now();
      document.querySelectorAll('.live-sla-timer').forEach(el => {
        const dueIso = el.getAttribute('data-due');
        if (!dueIso) return;
        const dueTime = new Date(dueIso).getTime();
        const diffSec = Math.floor((dueTime - now) / 1000);

        if (diffSec <= 0) {
          el.innerHTML = '<span class="badge badge-breached" style="animation: pulseBreach 1.5s infinite; font-size: 1rem; padding: 6px 12px;">SLA Süresi Aşıldı (İhlal)</span>';
        } else {
          const hours = Math.floor(diffSec / 3600);
          const mins = Math.floor((diffSec % 3600) / 60);
          const secs = diffSec % 60;
          const textEl = el.querySelector('.timer-text');
          if (textEl) {
            const hStr = hours > 0 ? `${hours}s ` : '';
            const mStr = `${mins < 10 ? '0' : ''}${mins}dk `;
            const sStr = `${secs < 10 ? '0' : ''}${secs}sn kaldı`;
            textEl.textContent = `${hStr}${mStr}${sStr}`;
          }

          if (diffSec <= 1800) {
            el.style.color = 'var(--danger)';
          } else if (diffSec <= 3600) {
            el.style.color = 'var(--warning-text)';
          }
        }
      });
    }

    async function pollThread() {
      // Formda yazarken kesintiye uğratma
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.id === 'comment-body-textarea' || activeEl.tagName === 'INPUT')) {
        return;
      }

      try {
        const response = await fetch(window.location.href, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) return;

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newThread = doc.querySelector('.thread-container');
        const currentThread = document.querySelector('.thread-container');
        const newComments = doc.querySelectorAll('.comment-card');

        if (newThread && currentThread && newComments.length !== currentCommentCount) {
          currentThread.innerHTML = newThread.innerHTML;
          currentCommentCount = newComments.length;

          // Sağ sidebar ve durum bilgilerini de güncelle
          const newSidebar = doc.querySelector('.detail-sidebar');
          const currentSidebar = document.querySelector('.detail-sidebar');
          if (newSidebar && currentSidebar) {
            currentSidebar.innerHTML = newSidebar.innerHTML;
            updateLiveSLATimers();
          }
        }
      } catch (e) {
        // Sessiz hata yakalama
      }
    }

    timerInterval = setInterval(updateLiveSLATimers, 1000);
    updateLiveSLATimers();

    pollInterval = setInterval(pollThread, 2500);

    document.addEventListener('turbo:before-cache', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    }, { once: true });

    window.addEventListener('beforeunload', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    });
  })();
</script>
