<div class="page-header">
  <div>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
      <h1 class="page-title" style="margin-bottom: 0;">Temsilci Destek Masası</h1>
      <span style="font-size: 0.72rem; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 2px 8px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 5px; font-weight: 600;">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: #10b981; animation: pulseDot 1.5s infinite; display: inline-block;"></span>
        Canlı Senkronizasyon (Yenilemesiz)
      </span>
    </div>
    <p class="page-subtitle">
      Gelen müşteri destek bildirimlerini, öncelik sıralamasını ve SLA çözüm sürelerini buradan yönetin.
    </p>
  </div>
  <div>
    <a href="<%= new_ticket_path %>" class="btn btn-primary" id="btn-new-ticket">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      Yeni Talep Kaydı
    </a>
  </div>
</div>

<!-- KPI Metrik Kartları -->
<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-card-header">
      <span class="kpi-title">Toplam Talep</span>
      <div class="kpi-icon" style="background: #f1f5f9; color: #475569;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
    </div>
    <div class="kpi-value"><%= @total_count %></div>
    <span class="kpi-subtext">Sistemdeki tüm kayıtlı biletler</span>
  </div>

  <div class="kpi-card">
    <div class="kpi-card-header">
      <span class="kpi-title">İşlemdeki Talepler</span>
      <div class="kpi-icon" style="background: var(--primary-light); color: var(--primary);">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <div class="kpi-value" style="color: var(--primary);"><%= @open_count %></div>
    <span class="kpi-subtext">Yeni, açık ve bekleyen biletler</span>
  </div>

  <div class="kpi-card">
    <div class="kpi-card-header">
      <span class="kpi-title">SLA İhlalleri</span>
      <div class="kpi-icon" style="background: var(--danger-light); color: var(--danger);">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
    </div>
    <div class="kpi-value" style="color: var(--danger);"><%= @breached_count %></div>
    <span class="kpi-subtext">Hedef çözüm süresini aşan talepler</span>
  </div>

  <div class="kpi-card">
    <div class="kpi-card-header">
      <span class="kpi-title">Nezaket Koruması (Gratitude Guard)</span>
      <div class="kpi-icon" style="background: var(--success-light); color: var(--success);">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
    </div>
    <div class="kpi-value" style="color: var(--success);">
      <%= @gratitude_saves %>
      <span style="font-size: 0.9rem; font-weight: 600; color: var(--success-text);">kurtarma</span>
    </div>
    <span class="kpi-subtext">Teşekkür mesajıyla gereksiz açılmayanlar</span>
  </div>
</div>

<!-- Bilet Listesi Tablosu -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      Destek Talepleri Akışı
    </div>

    <!-- Filtre Butonları -->
    <div class="filter-group">
      <a href="<%= temsilci_path %>" class="filter-pill <%= 'active' if params[:filter].blank? %>">
        Tümü (<%= @total_count %>)
      </a>
      <a href="<%= temsilci_path(filter: 'open') %>" class="filter-pill <%= 'active' if params[:filter] == 'open' %>">
        Açık Kuyruk (<%= @open_count %>)
      </a>
      <a href="<%= temsilci_path(filter: 'solved') %>" class="filter-pill <%= 'active' if params[:filter] == 'solved' %>">
        Çözülenler (<%= @solved_count %>)
      </a>
      <a href="<%= temsilci_path(filter: 'breached') %>" class="filter-pill breached-tab <%= 'active' if params[:filter] == 'breached' %>">
        SLA Aşımı (<%= @breached_count %>)
      </a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th style="width: 70px;">ID</th>
          <th style="width: 100px;">Öncelik</th>
          <th>Konu & Müşteri</th>
          <th style="width: 120px;">Durum</th>
          <th style="width: 200px;">SLA Süresi</th>
          <th style="width: 160px;">Temsilci</th>
          <th style="width: 90px; text-align: right;">İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% if @tickets.any? %>
          <% @tickets.each do |ticket| %>
            <tr>
              <td style="color: var(--text-muted); font-weight: 600; font-size: 0.82rem;">
                #<%= ticket.id %>
              </td>

              <td>
                <span class="badge badge-<%= ticket.priority %>">
                  <%= ticket.human_priority_name %>
                </span>
              </td>

              <td>
                <a href="<%= ticket_path(ticket) %>" class="ticket-link">
                  <%= ticket.title %>
                </a>
                <div class="ticket-customer">
                  <%= ticket.customer_name %> • <%= ticket.customer_email %>
                </div>
              </td>

              <td>
                <% status_class = case ticket.status
                   when "status_new" then "new"
                   when "status_open" then "open"
                   when "status_pending" then "pending"
                   when "status_solved" then "solved"
                   when "status_closed" then "closed"
                   end %>
                <span class="badge badge-<%= status_class %>">
                  <%= ticket.human_status_name %>
                </span>
              </td>

              <td>
                <% if ticket.status_solved? || ticket.status_closed? %>
                  <span style="color: var(--success); font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Tamamlandı
                  </span>
                <% elsif ticket.sla_breached? %>
                  <span class="badge badge-breached" style="animation: pulseBreach 1.5s infinite;">
                    SLA Süresi Aşıldı
                  </span>
                <% else %>
                  <% remaining = ticket.sla_remaining_seconds %>
                  <% hours = remaining / 3600 %>
                  <% mins = (remaining % 3600) / 60 %>
                  <% secs = remaining % 60 %>
                  <div class="live-sla-timer" data-due="<%= ticket.sla_due_at.iso8601 %>" style="font-weight: 600; font-size: 0.85rem; color: <%= ticket.sla_urgency_level == :warning ? 'var(--warning-text)' : 'var(--text-primary)' %>;">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
                    <span class="timer-text"><%= "#{hours}s " if hours > 0 %><%= sprintf('%02d', mins) %>dk <%= sprintf('%02d', secs) %>sn kaldı</span>
                  </div>
                  <div style="font-size: 0.72rem; color: var(--text-muted);">
                    Hedef: <%= ticket.sla_due_at.strftime("%H:%M (%d.%m)") %>
                  </div>
                <% end %>
              </td>

              <td>
                <% if ticket.assigned_agent.present? %>
                  <span style="font-size: 0.85rem; color: var(--text-primary); font-weight: 500;">
                    <%= ticket.assigned_agent %>
                  </span>
                <% else %>
                  <span style="font-size: 0.8rem; color: var(--text-muted); font-style: italic;">
                    Atanmadı
                  </span>
                <% end %>
              </td>

              <td style="text-align: right;">
                <a href="<%= ticket_path(ticket) %>" class="btn btn-secondary btn-sm">
                  Görüntüle
                </a>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <div style="font-size: 1.6rem; margin-bottom: 0.5rem;">
                <% if params[:filter] == 'breached' %>
                  🎉
                <% elsif params[:filter] == 'solved' %>
                  ✅
                <% else %>
                  📥
                <% end %>
              </div>
              <strong style="color: var(--text-primary); display: block; margin-bottom: 0.35rem; font-size: 0.95rem;">
                <% if params[:filter] == 'breached' %>
                  SLA Aşımı Bulunmuyor
                <% elsif params[:filter] == 'solved' %>
                  Henüz Çözülen Destek Talebi Yok
                <% elsif params[:filter] == 'open' %>
                  Açık Kuyrukta Bekleyen Talep Yok
                <% else %>
                  Kuyrukta Bekleyen Destek Talebi Yok
                <% end %>
              </strong>
              <span style="font-size: 0.85rem;">
                <% if params[:filter] == 'breached' %>
                  Tüm talepler SLA hedefleri içinde başarıyla yönetiliyor.
                <% else %>
                  Müşterilerden yeni bir destek talebi iletildiğinde bu ekrana <strong>sayfa yenilenmeden anlık olarak</strong> düşecektir.
                <% end %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function() {
    let currentTicketIds = Array.from(document.querySelectorAll('tbody tr td:first-child')).map(td => td.innerText.trim());
    let pollInterval = null;
    let timerInterval = null;

    function showToast(message) {
      const existing = document.querySelector('.toast-notification');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.className = 'toast-notification';
      toast.innerHTML = `<span style="font-size: 1.1rem;">🔔</span> <span>${message}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(15px)';
        setTimeout(() => toast.remove(), 400);
      }, 4000);
    }

    function updateLiveSLATimers() {
      const now = Date.now();
      document.querySelectorAll('.live-sla-timer').forEach(el => {
        const dueIso = el.getAttribute('data-due');
        if (!dueIso) return;
        const dueTime = new Date(dueIso).getTime();
        const diffSec = Math.floor((dueTime - now) / 1000);

        if (diffSec <= 0) {
          el.outerHTML = '<span class="badge badge-breached" style="animation: pulseBreach 1.5s infinite;">SLA Süresi Aşıldı</span>';
        } else {
          const hours = Math.floor(diffSec / 3600);
          const mins = Math.floor((diffSec % 3600) / 60);
          const secs = diffSec % 60;
          const textEl = el.querySelector('.timer-text');
          if (textEl) {
            const hStr = hours > 0 ? `${hours}s ` : '';
            const mStr = `${mins < 10 ? '0' : ''}${mins}dk `;
            const sStr = `${secs < 10 ? '0' : ''}${secs}sn kaldı`;
            textEl.textContent = `${hStr}${mStr}${sStr}`;
          }

          if (diffSec <= 1800) {
            el.style.color = 'var(--danger)';
          } else if (diffSec <= 3600) {
            el.style.color = 'var(--warning-text)';
          }
        }
      });
    }

    async function pollTickets() {
      try {
        const response = await fetch(window.location.href, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) return;

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newTbody = doc.querySelector('tbody');
        const currentTbody = document.querySelector('tbody');
        const newKpi = doc.querySelector('.kpi-grid');
        const currentKpi = document.querySelector('.kpi-grid');

        if (newTbody && currentTbody) {
          const newIds = Array.from(newTbody.querySelectorAll('tr td:first-child')).map(td => td.innerText.trim());

          // Yeni bilet kontrolü veya durum değişikliği
          const addedIds = newIds.filter(id => id && !currentTicketIds.includes(id));
          if (addedIds.length > 0 || newIds.join(',') !== currentTicketIds.join(',')) {
            currentTbody.innerHTML = newTbody.innerHTML;
            if (newKpi && currentKpi) {
              currentKpi.innerHTML = newKpi.innerHTML;
            }
            const newFilterGroup = doc.querySelector('.filter-group');
            const currentFilterGroup = document.querySelector('.filter-group');
            if (newFilterGroup && currentFilterGroup) {
              currentFilterGroup.innerHTML = newFilterGroup.innerHTML;
            }
            currentTicketIds = newIds;

            // Yeni düşen biletleri vurgula ve bildirim göster
            if (addedIds.length > 0) {
              const firstRow = currentTbody.querySelector('tr');
              if (firstRow) firstRow.classList.add('ticket-row-new');
              showToast(`Yeni Destek Talebi Düştü! (${addedIds[0]})`);
            }

            updateLiveSLATimers();
          }
        }
      } catch (e) {
        // Ağ gecikmelerinde sessiz kal
      }
    }

    // Her saniye sayaçları geriye işlet (yenilemesiz canlı sayaç)
    timerInterval = setInterval(updateLiveSLATimers, 1000);
    updateLiveSLATimers();

    // Her 2.5 saniyede bir yeni bilet ve durum kontrolü yap
    pollInterval = setInterval(pollTickets, 2500);

    document.addEventListener('turbo:before-cache', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    }, { once: true });

    window.addEventListener('beforeunload', () => {
      clearInterval(pollInterval);
      clearInterval(timerInterval);
    });
  })();
</script>
