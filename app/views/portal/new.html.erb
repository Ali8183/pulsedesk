<div style="max-width: 640px; margin: 0 auto 3rem;">
  
  <div style="text-align: center; margin-bottom: 2rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; margin-bottom: 1rem; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
    </div>
    <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.5rem;">
      Müşteri Destek Portalı
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      Bir sorun mu yaşıyorsunuz? Talebinizi iletin, destek ekibimiz anında incelesin.
    </p>
  </div>

  <!-- Var Olan Talebi Sorgulama Kartı -->
  <div class="card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; background: #f8fafc; border: 1px dashed var(--border-subtle);">
    <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem;">
      🔍 Önceden Açılmış Bir Biletiniz mi Var?
    </div>
    <%= form_with url: customer_lookup_path, method: :get, local: true, style: "display: flex; gap: 0.5rem; align-items: center;" do %>
      <input type="text" name="ticket_id" class="form-control" placeholder="Örn: 5 (Bilet Numaranızı Yazın)" style="flex: 1;" required>
      <button type="submit" class="btn btn-secondary btn-sm" style="white-space: nowrap; padding: 0.6rem 1rem;">
        Bileti Takip Et →
      </button>
    <% end %>
  </div>

  <!-- Yeni Talep Oluşturma Kartı -->
  <div class="card" style="padding: 2rem;">
    <div style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
      Yeni Destek Bildirimi Oluştur
    </div>

    <%= form_with model: @ticket, url: portal_path, local: true do |f| %>
      <% if @ticket.errors.any? %>
        <div class="flash-alert flash-alert-danger" style="margin-bottom: 1.5rem;">
          <div>
            <strong>Lütfen formu kontrol edin:</strong>
            <ul style="margin-top: 0.5rem; padding-left: 1.25rem;">
              <% @ticket.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :customer_name, "Adınız Soyadınız *", class: "form-label" %>
          <%= f.text_field :customer_name, class: "form-control", placeholder: "Örn: Mehmet Can", required: true %>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :customer_email, "E-Posta Adresiniz *", class: "form-label" %>
          <%= f.email_field :customer_email, class: "form-control", placeholder: "mehmet@sirketim.com", required: true %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :priority, "Talebin Aciliyeti *", class: "form-label" %>
        <%= f.select :priority, [
          ["⚡ Acil - Kritik Arıza (2 Saat Hedef)", "urgent"],
          ["🔴 Yüksek Öncelik (4 Saat Hedef)", "high"],
          ["🔵 Normal Talep (8 Saat Hedef)", "medium"]
        ], { selected: "urgent" }, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :title, "Konu Başlığı *", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "Örn: Ödeme ekranında 403 hatası alıyoruz", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :description, "Yaşadığınız Sorunun Detayı *", class: "form-label" %>
        <%= f.text_area :description, rows: 4, class: "form-control", placeholder: "Lütfen sorunu olabildiğince detaylı açıklayın...", required: true %>
      </div>

      <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <a href="/" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none;">
          ← Ana Sayfaya Dön
        </a>

        <button type="submit" class="btn btn-primary" id="btn-submit-portal">
          Talebi Gönder & Destek İste →
        </button>
      </div>
    <% end %>
  </div>
</div>
