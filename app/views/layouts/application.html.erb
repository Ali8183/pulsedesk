<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "PulseDesk | Kurumsal Müşteri Destek & Akıllı SLA Platformu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PulseDesk, kurumsal biletleme ve akıllı SLA yönetim platformudur.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="/" class="nav-brand">
          <div class="brand-icon-box">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">PulseDesk</div>
          </div>
          <% if controller_name == 'portal' %>
            <span class="brand-tag" style="background: #eff6ff; color: #2563eb; border-color: #bfdbfe;">Müşteri Destek Portalı</span>
          <% elsif controller_name == 'sessions' %>
            <span class="brand-tag" style="background: #fdf2f8; color: #9d174d; border-color: #fbcfe8;">Yetkili Personel Girişi</span>
          <% elsif agent_signed_in? %>
            <span class="brand-tag" style="background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe;">Temsilci Masası</span>
          <% else %>
            <span class="brand-tag">Kurumsal Destek Platformu</span>
          <% end %>
        </a>
      </div>

      <nav class="nav-links">
        <% if controller_name == 'portal' %>
          <!-- MÜŞTERİ PORTALINDA GÖRÜNEN MENÜ -->
          <a href="/" class="nav-link">
            ← Ana Sayfa
          </a>
          <a href="<%= customer_portal_path %>" class="btn btn-primary btn-sm">
            + Yeni Talep Aç
          </a>
          <% if agent_signed_in? %>
            <a href="<%= tickets_path %>" class="nav-link" style="color: #6d28d9; font-weight: 600;">
              💻 Temsilci Masasına Dön ↗
            </a>
          <% end %>

        <% elsif controller_name == 'sessions' %>
          <!-- TEMSİLCİ GİRİŞ EKRANINDA GÖRÜNEN MENÜ -->
          <a href="/" class="nav-link">
            ← Ana Sayfa
          </a>
          <a href="<%= customer_portal_path %>" class="btn btn-secondary btn-sm">
            Müşteri Portalı (/musteri) ↗
          </a>

        <% elsif agent_signed_in? %>
          <!-- TEMSİLCİ GİRİŞİ YAPILMIŞSA GÖRÜNEN YÖNETİM MENÜSÜ -->
          <a href="<%= tickets_path %>" class="nav-link <%= 'active' if (current_page?(tickets_path) || current_page?(root_path)) && params[:filter].blank? && controller_name == 'tickets' %>">
            Tüm Talepler
          </a>
          <a href="<%= tickets_path(filter: 'open') %>" class="nav-link <%= 'active' if params[:filter] == 'open' %>">
            Açık Kuyruk
          </a>
          <a href="<%= tickets_path(filter: 'breached') %>" class="nav-link <%= 'danger-link' if params[:filter] == 'breached' %>">
            SLA Alarmları
          </a>
          <a href="<%= customer_portal_path %>" target="_blank" class="nav-link" style="color: #2563eb; background: #eff6ff; border: 1px solid #bfdbfe; font-weight: 600;">
            📱 Müşteri Portalı (/musteri) ↗
          </a>

          <!-- Aktif Temsilci Profili & Çıkış -->
          <div style="display: flex; align-items: center; gap: 0.6rem; padding-left: 0.5rem; border-left: 1px solid var(--border-subtle);">
            <div style="font-size: 0.78rem; text-align: right; line-height: 1.2;">
              <strong style="color: var(--text-primary); display: block;"><%= current_agent %></strong>
              <span style="color: var(--text-muted); font-size: 0.7rem;"><%= current_agent_title %></span>
            </div>
            <%= button_to agent_logout_path, method: :delete, class: "btn btn-secondary btn-sm", style: "padding: 0.3rem 0.6rem; font-size: 0.75rem;", title: "Oturumu Kapat" do %>
              Çıkış
            <% end %>
          </div>

        <% else %>
          <!-- GİRİŞ YAPILMAMIŞ GİRİŞ SAYFASI MENÜSÜ -->
          <a href="<%= customer_portal_path %>" class="btn btn-secondary btn-sm" style="font-weight: 600;">
            Müşteri Girişi (/musteri)
          </a>
          <a href="<%= agent_portal_path %>" class="btn btn-primary btn-sm" style="font-weight: 600;">
            🔒 Yetkili Temsilci Girişi (/temsilci) →
          </a>
        <% end %>
      </nav>
    </header>

    <% if notice || alert %>
      <div class="flash-container">
        <% if notice %>
          <div class="flash-alert flash-notice">
            <span><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert flash-alert-danger">
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <strong>PulseDesk</strong> — Fortune 500 Ölçeğinde Destek & Akıllı SLA Biletleme Platformu
        </div>
        <div>
          Güvenli Yetkilendirme & Rol Tabanlı Erişim (RBAC) Devrede
        </div>
      </div>
    </footer>
  </body>
</html>
