<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "PulseDesk | Müşteri Destek & Biletleme Platformu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PulseDesk, kurumsal biletleme ve akıllı SLA yönetim platformudur.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <a href="/" class="nav-brand">
          <div class="brand-icon-box">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">PulseDesk</div>
          </div>
          <span class="brand-tag">Destek Masası</span>
        </a>
      </div>

      <nav class="nav-links">
        <a href="<%= tickets_path %>" class="nav-link <%= 'active' if (current_page?(tickets_path) || current_page?(root_path)) && params[:filter].blank? %>">
          Tüm Talepler
        </a>
        <a href="<%= tickets_path(filter: 'open') %>" class="nav-link <%= 'active' if params[:filter] == 'open' %>">
          Açık Kuyruk
        </a>
        <a href="<%= tickets_path(filter: 'breached') %>" class="nav-link <%= 'danger-link' if params[:filter] == 'breached' %>">
          SLA Alarmları
        </a>
        <a href="<%= new_ticket_path %>" class="btn btn-primary btn-sm">
          + Yeni Talep
        </a>
        <span class="live-indicator">
          <span class="live-dot"></span>
          Canlı Sistem
        </span>
      </nav>
    </header>

    <% if notice || alert %>
      <div class="flash-container">
        <% if notice %>
          <div class="flash-alert flash-notice">
            <span><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert flash-alert-danger">
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <strong>PulseDesk</strong> — Kurumsal Müşteri Destek & Akıllı SLA Motoru
        </div>
        <div>
          Akıllı Nezaket Koruması (Gratitude Guard) devrede
        </div>
      </div>
    </footer>
  </body>
</html>
