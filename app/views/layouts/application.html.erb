<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "PulseDesk | Kurumsal Müşteri Destek & Akıllı SLA Platformu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PulseDesk, kurumsal biletleme ve akıllı SLA yönetim platformudur.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="/" class="nav-brand">
          <div class="brand-icon-box">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">PulseDesk</div>
          </div>
          <% if customer_signed_in? %>
            <span class="brand-tag" style="background: #eff6ff; color: #2563eb; border-color: #bfdbfe;">Müşteri Portalı</span>
          <% elsif agent_signed_in? %>
            <span class="brand-tag" style="background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe;">Temsilci Masası</span>
          <% else %>
            <span class="brand-tag">Kurumsal Destek Platformu</span>
          <% end %>
        </a>
      </div>

      <nav class="nav-links">
        <% if customer_signed_in? %>
          <!-- MÜŞTERİ OTURUMU AÇIKKEN -->
          <a href="<%= musteri_path %>" class="nav-link <%= 'active' if controller_name == 'musteri' %>">
            Taleplerim
          </a>

          <div style="display: flex; align-items: center; gap: 0.6rem; padding-left: 0.5rem; border-left: 1px solid var(--border-subtle);">
            <div style="font-size: 0.78rem; text-align: right; line-height: 1.2;">
              <strong style="color: var(--text-primary); display: block;"><%= current_customer_name %></strong>
              <span style="color: var(--text-muted); font-size: 0.7rem;">Müşteri Hesabı</span>
            </div>
            <%= button_to musteri_cikis_path, method: :delete, class: "btn btn-secondary btn-sm", style: "padding: 0.3rem 0.6rem; font-size: 0.75rem;", title: "Müşteri Oturumunu Kapat" do %>
              Çıkış
            <% end %>
          </div>

          <a href="<%= temsilci_path %>" class="btn btn-secondary btn-sm" style="color: #6d28d9; border-color: #ddd6fe; font-size: 0.75rem;">
            Temsilci Masası 🔒
          </a>

        <% elsif agent_signed_in? %>
          <!-- TEMSİLCİ OTURUMU AÇIKKEN -->
          <a href="<%= temsilci_path %>" class="nav-link <%= 'active' if controller_name == 'tickets' && params[:filter].blank? %>">
            Tüm Talepler
          </a>
          <a href="<%= temsilci_path(filter: 'open') %>" class="nav-link <%= 'active' if params[:filter] == 'open' %>">
            Açık Kuyruk
          </a>
          <a href="<%= temsilci_path(filter: 'breached') %>" class="nav-link <%= 'danger-link' if params[:filter] == 'breached' %>">
            SLA Alarmları
          </a>

          <div style="display: flex; align-items: center; gap: 0.6rem; padding-left: 0.5rem; border-left: 1px solid var(--border-subtle);">
            <div style="font-size: 0.78rem; text-align: right; line-height: 1.2;">
              <strong style="color: var(--text-primary); display: block;"><%= current_agent %></strong>
              <span style="color: var(--text-muted); font-size: 0.7rem;"><%= current_agent_title %></span>
            </div>
            <%= button_to temsilci_cikis_path, method: :delete, class: "btn btn-secondary btn-sm", style: "padding: 0.3rem 0.6rem; font-size: 0.75rem;", title: "Temsilci Oturumunu Kapat" do %>
              Çıkış
            <% end %>
          </div>

          <a href="<%= musteri_path %>" class="btn btn-secondary btn-sm" style="color: #2563eb; border-color: #bfdbfe; font-size: 0.75rem;">
            Müşteri Portalı 📱
          </a>

        <% else %>
          <!-- GİRİŞ YAPILMAMIŞSA (ZİYARETÇİ) -->
          <a href="<%= musteri_path %>" class="btn btn-secondary btn-sm" style="font-weight: 600;">
            📱 Müşteri Girişi (/musteri)
          </a>
          <a href="<%= temsilci_path %>" class="btn btn-primary btn-sm" style="font-weight: 600;">
            🔒 Temsilci Girişi (/temsilci)
          </a>
        <% end %>
      </nav>
    </header>

    <% if notice || alert %>
      <div class="flash-container">
        <% if notice %>
          <div class="flash-alert flash-notice">
            <span><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert flash-alert-danger">
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <strong>PulseDesk</strong> — Fortune 500 Ölçeğinde Destek & Akıllı SLA Biletleme Platformu
        </div>
        <div>
          Güvenli Yetkilendirme & Rol Tabanlı Erişim (RBAC) Devrede
        </div>
      </div>
    </footer>
  </body>
</html>
