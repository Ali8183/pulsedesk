<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "PulseDesk | Kurumsal Müşteri Destek & Biletleme Platformu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PulseDesk, Fortune 500 ölçeğinde müşteri biletleme ve akıllı SLA yönetim platformudur.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="/" class="nav-brand">
          <div class="brand-icon">⚡</div>
          <span>PulseDesk</span>
          <span class="brand-badge">SLA & Gratitude Guard Edition</span>
        </a>
      </div>

      <nav class="nav-links">
        <a href="<%= tickets_path %>" class="nav-link <%= 'active' if current_page?(tickets_path) || current_page?(root_path) %>">Talepler Paneli</a>
        <a href="<%= tickets_path(filter: 'breached') %>" class="nav-link" style="color: #f87171;">SLA Alarmları</a>
        <a href="<%= new_ticket_path %>" class="btn btn-primary btn-sm">+ Yeni Talep Aç</a>
        <span style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: #34d399; background: rgba(16, 185, 129, 0.15); padding: 4px 10px; border-radius: 20px; border: 1px solid rgba(16, 185, 129, 0.3);">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
          Canlı / Aort Dilimi Aktif
        </span>
      </nav>
    </header>

    <% if notice || alert %>
      <div class="flash-container">
        <% if notice %>
          <div class="flash-alert flash-notice">
            <span><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert flash-alert-danger">
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <strong>PulseDesk</strong> — Fortune 500 Ölçeğinde Ruby on Rails 8 Biletleme Aort Dilimi.
        </div>
        <div style="color: var(--text-dim);">
          100 Puanlık Özellik: <strong>Gratitude Guard (Akıllı Nezaket Koruması)</strong> Entegre Edilmiştir.
        </div>
      </div>
    </footer>
  </body>
</html>
