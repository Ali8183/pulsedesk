<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "PulseDesk | Kurumsal Müşteri Destek & Akıllı SLA Platformu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PulseDesk, kurumsal biletleme ve akıllı SLA yönetim platformudur.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% is_customer_portal = (controller_name == "musteri") %>

    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="<%= is_customer_portal ? root_path : temsilci_path %>" class="nav-brand">
          <div class="brand-icon-box">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">PulseDesk</div>
          </div>
          <% if is_customer_portal %>
            <span class="brand-tag" style="background: #eff6ff; color: #2563eb; border-color: #bfdbfe;">Müşteri Portalı</span>
          <% else %>
            <span class="brand-tag" style="background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe;">Temsilci Masası</span>
          <% end %>
        </a>
      </div>

      <nav class="nav-links">
        <% if is_customer_portal %>
          <!-- MÜŞTERİ TARAFI MENÜSÜ: ASLA TEMSİLCİ BİLGİSİ VEYA LİNKİ GÖSTERİLMEZ -->
          <% if customer_signed_in? %>
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <div style="font-size: 0.78rem; text-align: right; line-height: 1.2;">
                <strong style="color: var(--text-primary); display: block;"><%= current_customer_name %></strong>
                <span style="color: var(--text-muted); font-size: 0.7rem;">Müşteri Hesabı</span>
              </div>
              <%= button_to musteri_cikis_path, method: :delete, class: "btn btn-secondary btn-sm", style: "padding: 0.3rem 0.6rem; font-size: 0.75rem;", title: "Müşteri Oturumunu Kapat" do %>
                Çıkış
              <% end %>
            </div>
          <% else %>
            <div style="font-size: 0.82rem; color: var(--text-muted);">
              Müşteri Destek Sistemi
            </div>
          <% end %>

        <% else %>
          <!-- TEMSİLCİ TARAFI MENÜSÜ: SADECE /temsilci VE BAĞLI SAYFALARDA -->
          <% if agent_signed_in? %>
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <div style="font-size: 0.78rem; text-align: right; line-height: 1.2;">
                <strong style="color: var(--text-primary); display: block;"><%= current_agent %></strong>
                <span style="color: var(--text-muted); font-size: 0.7rem;"><%= current_agent_title %></span>
              </div>
              <%= button_to temsilci_cikis_path, method: :delete, class: "btn btn-secondary btn-sm", style: "padding: 0.3rem 0.6rem; font-size: 0.75rem;", title: "Temsilci Oturumunu Kapat" do %>
                Çıkış
              <% end %>
            </div>
          <% else %>
            <div style="font-size: 0.82rem; color: var(--text-muted);">
              Yetkili Personel Masası
            </div>
          <% end %>
        <% end %>
      </nav>
    </header>

    <% if notice || alert %>
      <div class="flash-container">
        <% if notice %>
          <div class="flash-alert flash-notice">
            <span><%= notice %></span>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert flash-alert-danger">
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <strong>PulseDesk</strong> — Fortune 500 Ölçeğinde Destek & Akıllı SLA Biletleme Platformu
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted);">
          Güvenli Yetkilendirme & Rol Tabanlı Erişim (RBAC) Devrede
        </div>
      </div>
    </footer>
  </body>
</html>
